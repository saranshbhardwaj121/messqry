# Select the environment represented by the API this bundle connects to.
# VITE_ variables are public build-time configuration; never put secrets here.
VITE_DEPLOYMENT_ENV=local
# Optional absolute URL for an API outside the local Vite proxy.
# VITE_API_BASE_URL=https://api.example.com
# Required for production builds. Use a Cognito public app client with the
# authorization-code grant and PKCE; never put a client secret here.
# VITE_COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
# VITE_COGNITO_CLIENT_ID=your-public-app-client-id
# VITE_COGNITO_REDIRECT_URI=https://console.example.com/
# VITE_COGNITO_LOGOUT_URI=https://console.example.com/
# The Cognito app client must have the requested custom API scopes configured.
# VITE_COGNITO_SCOPES=openid email profile messqry/registry.read messqry/registry.write messqry/deployment.read messqry/deployment.write messqry/prediction.invoke
