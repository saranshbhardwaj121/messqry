MESSQRY_APP_NAME="MessQry AI"
MESSQRY_ENVIRONMENT=development
MESSQRY_DOCS_ENABLED=true
MESSQRY_DATABASE_URL=sqlite:///./messqry.db
MESSQRY_ARTIFACT_STORAGE=local
MESSQRY_ARTIFACT_LOCAL_ROOT=./artifacts
MESSQRY_ARTIFACT_S3_BUCKET=
MESSQRY_ARTIFACT_S3_PREFIX=messqry
MESSQRY_AUTH_DEV_BYPASS=true
# Required for staging/production; Cognito access-token app client IDs.
MESSQRY_OIDC_ISSUER=
MESSQRY_OIDC_AUDIENCE=
MESSQRY_OIDC_SERVICE_CLIENT_IDS=
# Optional model-task launcher; disabled until private ECS infrastructure is configured.
MESSQRY_RUNTIME_BACKEND=disabled
MESSQRY_AWS_REGION=
MESSQRY_ECS_CLUSTER=
MESSQRY_ECS_TASK_DEFINITION=
MESSQRY_ECS_CONTAINER_NAME=
# Configure private subnet and security-group IDs; public IP assignment is disabled.
MESSQRY_ECS_SUBNET_IDS=
MESSQRY_ECS_SECURITY_GROUP_IDS=
MESSQRY_RUNTIME_PORT=8000
MESSQRY_RUNTIME_STARTUP_TIMEOUT_SECONDS=60
